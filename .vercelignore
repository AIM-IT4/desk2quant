# Gauntlet answer keys and reference solutions must never be deployed.
# outputDirectory is "." so anything in the repo root is otherwise web-served
# (this is how docs/*.md leaked publicly). The vercel.json rewrites are a
# second layer in case this file is ever lost.
gauntlet/hidden/
gauntlet/projects/*/reference.mjs

# Paid project kits: the README (spec) stays public so buyers can judge the
# work before paying, but the starter and public tests ARE the deliverable and
# ship only inside the purchased ZIP. The free warm-up (00) is exempt because
# the browser playground fetches its files directly.
gauntlet/projects/01-sofr-curve/starter.py
gauntlet/projects/01-sofr-curve/sample_tests.py

# Internal working notes.
_private_notes/
_couponfix_backup/

# Tests are not needed at runtime.
test/

# graft's cache contains extracted source INCLUDING the gauntlet reference
# solutions. It is in .gitignore, but Vercel CLI uses THIS file instead of
# .gitignore, so without this line a `vercel --prod` from a dev machine would
# publish the answer key under outputDirectory ".".
graft/

# Build/tooling that must never be web-served.
# NOTE: scripts/ is deliberately NOT listed here — buildCommand runs
# `node scripts/build-seo.js`, so excluding it would break the build. It is
# blocked from web access by the /scripts/:path* rewrite in vercel.json instead.
supabase/
.claude/
