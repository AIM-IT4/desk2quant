\section{Formula Reference}
Throughout, \(S_t\) denotes domestic currency units per one unit of foreign currency, \(r_d\) and \(r_f\) are domestic and foreign continuously compounded rates, \(T\) is maturity, and \(\sigma\) is annualized volatility.

\subsection*{Covered interest parity}
\[F(0,T)=S_0 e^{(r_d-r_f)T}=S_0\frac{P_f(0,T)}{P_d(0,T)}.\]

\subsection*{Garman--Kohlhagen}
\[C=S_0e^{-r_fT}N(d_1)-Ke^{-r_dT}N(d_2),\qquad P=Ke^{-r_dT}N(-d_2)-S_0e^{-r_fT}N(-d_1),\]
\[d_1=\frac{\ln(S_0/K)+(r_d-r_f+\tfrac12\sigma^2)T}{\sigma\sqrt{T}},\qquad d_2=d_1-\sigma\sqrt{T}.\]

\subsection*{FX put--call parity}
\[C-P=S_0e^{-r_fT}-Ke^{-r_dT}.\]

\subsection*{Core Greeks}
\[\Delta_{\mathrm{spot}}^{C}=e^{-r_fT}N(d_1),\qquad \Delta_{\mathrm{fwd}}^{C}=N(d_1),\]
\[\Gamma=\frac{e^{-r_fT}n(d_1)}{S_0\sigma\sqrt{T}},\qquad \nu=S_0e^{-r_fT}n(d_1)\sqrt{T}.\]

\subsection*{FX smile quotes}
\[RR_{25}=\sigma_{25C}-\sigma_{25P},\qquad BF_{25}=\frac{\sigma_{25C}+\sigma_{25P}}{2}-\sigma_{\mathrm{ATM}}.\]

\subsection*{Risk-neutral FX dynamics}
\[dS_t=(r_d-r_f)S_t\,dt+\sigma S_t\,dW_t.\]

\subsection*{Quanto intuition}
The quanto drift correction is proportional to \(\rho\sigma_X\sigma_S\), with sign determined by the precise FX quote, numeraire, and payoff convention.

