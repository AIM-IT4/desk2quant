# Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to GitHub!

# Supabase Configuration
# Get these from your Supabase dashboard: Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# EmailJS Configuration
# Get these from your EmailJS dashboard
EMAILJS_USER_ID=your-emailjs-user-id
EMAILJS_SERVICE_ID=your-emailjs-service-id
EMAILJS_TEMPLATE_ID=your-emailjs-template-id

# Formspree Configuration
FORMSPREE_ID=your-formspree-id

# Razorpay Configuration (payment gateway - supports international cards & multi-currency)
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Admin Panel Password (change this to something secure!)
ADMIN_PASSWORD=your-secure-password-here

# Transactional email (Brevo)
# BREVO_API_KEY is required or no mail is sent at all.
# SENDER_EMAIL must be a VERIFIED sender in Brevo, or every send is rejected.
# All three fall back to desk2quant@gmail.com when unset -- set them explicitly.
BREVO_API_KEY=xkeysib-your-api-key-here
SENDER_EMAIL=hello@desk2quant.com
SENDER_NAME=Desk2Quant
REPLY_TO_EMAIL=hello@desk2quant.com
# Where purchase/booking notifications land. Comma-separated for several inboxes.
ADMIN_EMAIL=hello@desk2quant.com

# Cron authentication -- REQUIRED.
# api/send-latest-products, send-promo-latest and send-single-buyer-offers
# now fail closed (503) without it. Use a long random string.
CRON_SECRET=your-long-random-cron-secret

# Signs interview session tokens. Falls back to RAZORPAY_KEY_SECRET when unset.
INTERVIEW_SESSION_SECRET=your-long-random-session-secret
