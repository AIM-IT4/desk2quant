{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node generate-config.js && node scripts/build-seo.js",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/health.json"
    },
    {
      "source": "/api/auth/linkedin/callback",
      "destination": "/api/admin-auth"
    },
    {
      "source": "/api/linkedin",
      "destination": "/api/admin-auth"
    }
  ],
  "redirects": [
    {
      "source": "/api/reminders.js",
      "destination": "/api/reminders",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "www.desk2quant.com"
        }
      ],
      "destination": "https://desk2quant.com/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "desk2quant.vercel.app"
        }
      ],
      "destination": "https://desk2quant.com/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "quant-mentor.vercel.app"
        }
      ],
      "destination": "https://desk2quant.com/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/quant-interview-problem-book-1000-plus-problems-with-solutions.html",
