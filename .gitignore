# Environment variables
.env
.env.local
.env.*.local

# API Keys and Secrets
secrets.json
config.json
config.js
*.key
*.pem

# Dependency directories
node_modules/
vendor/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Temporary files
tmp/
temp/
*.tmp

# Large media & binaries
*.exe
*.mp3
.vercel
.env*

# Generated by scripts/preview-emails.mjs -- rebuild with `node scripts/preview-emails.mjs`
email-preview-generated.html
email-preview-flow.html
email-preview-new.html

# Python bytecode from running the Gauntlet starter kits locally.
__pycache__/
*.pyc

# Gauntlet answer keys and reference solutions must never be committed:
# this repo is PUBLIC, so anything tracked is readable at
# raw.githubusercontent.com regardless of .vercelignore or vercel.json.
# Keep them locally; back them up outside the repo.
gauntlet/hidden/
gauntlet/projects/*/reference.mjs
